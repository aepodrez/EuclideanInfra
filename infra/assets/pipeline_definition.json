      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.rivol_spread_result",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "CheckPreflightComplete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.monthly_context.preflight",
          "BooleanEquals": true,
          "Next": "PreflightComplete"
        }
      ],
      "Default": "RunAlphaModel"
    },
    "PreflightComplete": {
      "Type": "Succeed"
    },
    "InitializeRIVolStatus": {
      "Type": "Pass",
      "Result": {
        "status": "ok",
        "predictor": "ZZ1_RIVolSpread"
      },
      "ResultPath": "$.rivol_status",
      "Next": "RunRIVolSpread"
    },
    "MarkRIVolFailed": {
      "Type": "Pass",
      "Result": {
        "status": "failed",
        "predictor": "ZZ1_RIVolSpread"
      },
      "ResultPath": "$.rivol_status",
      "Next": "BuildPredictorAvailability"
    }
  }
}
