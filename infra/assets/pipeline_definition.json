{
  "Comment": "Euclidean monthly decision pipeline: SignalMaster -> predictors -> alpha -> portfolio",
  "StartAt": "ResolveMonthlyContext",
  "States": {
    "AlphaModelFailed": {
      "Cause": "Alpha model failed, used fallback, or produced no rows.",
      "Error": "AlphaModelFailed",
      "Type": "Fail"
    },
    "BuildPredictorAvailability": {
      "Next": "CheckPredictorAvailability",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:954976294836:function:euclidean-predictor-availability",
        "Payload": {
          "as_of_month.$": "$.monthly_context.as_of_month",
          "mode": "reconcile",
          "preflight.$": "$.monthly_context.preflight",
          "predictor_results.$": "$.predictor_results",
          "run_id.$": "$.monthly_context.run_id",
          "source_snapshot_sha256.$": "$.monthly_context.source_snapshot_sha256",
          "rivol_status.$": "$.rivol_status"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.predictor_availability_result",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "CheckPredictorAvailability": {
      "Choices": [
        {
          "And": [
            {
              "NumericEquals": 0,
              "Variable": "$.predictor_availability_result.Payload.states.failed_quality"
            },
            {
              "NumericGreaterThan": 0,
              "Variable": "$.predictor_availability_result.Payload.states.active"
            },
            {
              "NumericEquals": 212,
              "Variable": "$.predictor_availability_result.Payload.row_count"
            },
            {
              "NumericEquals": 212,
              "Variable": "$.predictor_availability_result.Payload.expected_predictor_count"
            },
            {
              "NumericEqualsPath": "$.monthly_context.as_of_month",
              "Variable": "$.predictor_availability_result.Payload.as_of_month"
            },
            {
              "StringEqualsPath": "$.monthly_context.run_id",
              "Variable": "$.predictor_availability_result.Payload.run_id"
            },
            {
              "IsPresent": true,
              "Variable": "$.predictor_availability_result.Payload.manifest_sha256"
            },
            {
              "IsPresent": true,
              "Variable": "$.predictor_availability_result.Payload.output_sha256"
            }
          ],
          "Next": "CheckPreflightComplete"
        }
      ],
      "Default": "PredictorAvailabilityFailed",
      "Type": "Choice"
    },
    "PredictorAvailabilityFailed": {
      "Cause": "Predictor availability is incomplete, failed quality, or has no active potent predictor.",
      "Error": "PredictorAvailabilityFailed",
      "Type": "Fail"
    },
    "SignalMasterFailed": {
      "Cause": "SignalMaster failed quality, omitted its registry, or used mixed monthly lineage.",
      "Error": "SignalMasterFailed",
      "Type": "Fail"
    },
    "ResolveMonthlyContext": {
      "Next": "RunSignalMaster",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:954976294836:function:euclidean-predictor-availability",
        "Payload": {
          "execution_id.$": "$$.Execution.Id",
          "mode": "context",
          "request.$": "$"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$.monthly_context",
      "ResultSelector": {
        "as_of_month.$": "$.Payload.as_of_month",
        "preflight.$": "$.Payload.preflight",
        "production_enabled.$": "$.Payload.production_enabled",
        "quality_migration.$": "$.Payload.quality_migration",
        "portfolio_inputs": {
          "daily_crsp": {
            "key.$": "$.Payload.portfolio_inputs.daily_crsp.key",
            "sha256.$": "$.Payload.portfolio_inputs.daily_crsp.sha256"
          },
          "universe": {
            "key.$": "$.Payload.portfolio_inputs.universe.key",
            "sha256.$": "$.Payload.portfolio_inputs.universe.sha256"
          }
        },
        "run_id.$": "$.Payload.run_id",
        "source_manifest_count.$": "$.Payload.source_manifest_count",
        "source_snapshot_sha256.$": "$.Payload.source_snapshot_sha256",
        "statusCode.$": "$.Payload.statusCode",
        "predictor_policy_version.$": "$.Payload.predictor_policy_version"
      },
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Type": "Task"
    },
    "CheckAlphaModelResult": {
      "Choices": [
        {
          "And": [
            {
              "NumericEquals": 200,
              "Variable": "$.alpha_model_result.statusCode"
            },
            {
              "BooleanEquals": false,
              "Variable": "$.alpha_model_result.used_fallback"
            },
            {
              "NumericGreaterThan": 0,
              "Variable": "$.alpha_model_result.row_count"
            },
            {
              "NumericEqualsPath": "$.monthly_context.as_of_month",
              "Variable": "$.alpha_model_result.as_of_month"
            },
            {
              "StringEqualsPath": "$.predictor_availability_result.Payload.output_sha256",
              "Variable": "$.alpha_model_result.predictor_availability_sha256"
            },
            {
              "IsPresent": true,
              "Variable": "$.alpha_model_result.output_sha256"
            }
          ],
          "Next": "CheckPortfolioPublication"
        }
      ],
      "Default": "AlphaModelFailed",
      "Type": "Choice"
    },
    "CheckPortfolioPublication": {
      "Choices": [
        {
          "Variable": "$.monthly_context.production_enabled",
          "BooleanEquals": true,
          "Next": "RunPortfolioConstruction"
        }
      ],
      "Default": "MonthlyProductionDisabled",
      "Type": "Choice"
    },
    "MonthlyProductionDisabled": {
      "Cause": "Monthly preflight was not requested and production publication is disabled.",
      "Error": "MonthlyProductionDisabled",
      "Type": "Fail"
    },
